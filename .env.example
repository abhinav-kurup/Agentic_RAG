# LLM providers
GROQ_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=

# Optional: LlamaParse instead of PyMuPDF
PARSER_TYPE=pymupdf
LLAMA_CLOUD_API_KEY=

# Per-agent model overrides (provider/model)
PLANNER_MODEL=groq/llama-3.3-70b-versatile
RETRIEVAL_MODEL=groq/llama-3.1-8b-instant
EXTRACTION_MODEL=gemini/gemini-2.0-flash-lite
ANALYSIS_MODEL=gemini/gemini-2.0-flash
AGENT_MODEL=groq/llama-3.3-70b-versatile
RAGAS_EVAL_MODEL=groq/llama-3.3-70b-versatile

# Agentic loop
AGENT_MAX_HOPS=5
EVIDENCE_MAX_CHUNKS=10
MEMORY_MESSAGE_WINDOW=16

# Retrieval
EMBEDDING_MODEL=BAAI/bge-m3
COHERE_RERANK_MODEL=rerank-v4.0-fast
USE_CROSS_ENCODER=true

# Infra
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documind_collection
REDIS_URL=redis://localhost:6379/0
INGEST_QUEUE_NAME=documind:ingest

# API / UI
API_HOST=0.0.0.0
API_PORT=8000
DOCUMIND_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Voice
ENABLE_VOICE=true
ENABLE_TTS=true
WHISPER_MODEL=small.en
PIPER_VOICE=en_US-lessac-medium

# Layout / vision (slow; leave false unless you need figure captions)
ENABLE_IMAGE_PROCESSING=false
VISION_MODEL=gemini/gemini-2.0-flash-lite

# Optional LangSmith
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agentic-rag
